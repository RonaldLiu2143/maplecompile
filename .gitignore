# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local / editor
AGENTS.md
CLAUDE.md

# playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
.playwright-cli/

# local agent / research scratch (never commit)
.agents/
.impeccable/
__pycache__/
tmp_*
tmp-*/
tmp-*
class-fd.json
/scripts/patch_*.py
/scripts/strip_*.py
/scripts/recolor_*.py
/scripts/tmp_*.js

# extra copied Cursor skills (impeccable is tracked)
.cursor/agents/
.cursor/skills/*
!.cursor/skills/impeccable/
!.cursor/skills/impeccable/**
